{
  "type": "object",
  "required": [
    "archive_format",
    "archive_schema_version",
    "source",
    "participant_contract",
    "selection",
    "checkpoints",
    "normalized_definitions",
    "migration_descriptors",
    "participants",
    "archive_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "archive_format": {
      "const": "determa.archive"
    },
    "archive_schema_version": {
      "const": 1
    },
    "selection": {
      "type": "object",
      "required": [
        "root_instance_ids",
        "consistency_token"
      ],
      "additionalProperties": false,
      "properties": {
        "root_instance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consistency_token": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "execution-checkpoint-v1.schema.json"
      }
    },
    "normalized_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "validated_bundle_fingerprint",
          "normalized_bundle"
        ],
        "additionalProperties": false,
        "properties": {
          "validated_bundle_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "normalized_bundle": {
            "$ref": "aggregate-state-v1.schema.json#/$defs/typedValue"
          }
        }
      }
    },
    "migration_descriptors": {
      "type": "array",
      "items": {
        "$ref": "migration-descriptor-v1.schema.json"
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "archive-participant-v1.schema.json"
      }
    },
    "archive_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "participant_contract": {
      "$ref": "#/$defs/participantContract"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/state/schema/archive-v1.schema.json",
  "title": "Determa portable archive version 1",
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "profile_kind",
        "profile_claims",
        "profile_digest",
        "logical_scope_identity",
        "ownership_binding_digest",
        "scope_generation"
      ],
      "additionalProperties": false,
      "properties": {
        "profile_kind": {
          "enum": [
            "standalone",
            "checkpoint_host",
            "guarded_scope"
          ]
        },
        "profile_claims": {
          "type": "array",
          "items": {
            "enum": [
              "durable_embedded_processing",
              "exactly_once_committed_processing",
              "broker_integrated",
              "strict_durable_outbox",
              "compact_durable_outbox",
              "shared_application_transaction",
              "guarded_local_writes",
              "worker_fencing",
              "complete_scope_inventory",
              "safe_relocation",
              "durable_native_results",
              "lossless_projection"
            ]
          },
          "uniqueItems": true
        },
        "profile_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "logical_scope_identity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "ownership_binding_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "scope_generation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile_kind": {
                "const": "standalone"
              }
            },
            "required": [
              "profile_kind"
            ]
          },
          "then": {
            "properties": {
              "profile_claims": {
                "const": []
              },
              "logical_scope_identity": {
                "type": "null"
              },
              "ownership_binding_digest": {
                "type": "null"
              },
              "scope_generation": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile_kind": {
                "const": "guarded_scope"
              }
            },
            "required": [
              "profile_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_scope_identity": {
                "type": "string",
                "minLength": 1
              },
              "ownership_binding_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "scope_generation": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "profile_claims": {
                "type": "array",
                "contains": {
                  "const": "guarded_local_writes"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile_kind": {
                "const": "checkpoint_host"
              }
            },
            "required": [
              "profile_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_scope_identity": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "participantContract": {
      "type": "object",
      "required": [
        "required_participant_ids",
        "optional_participant_ids",
        "participant_contract_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "required_participant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "uniqueItems": true
        },
        "optional_participant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "uniqueItems": true
        },
        "participant_contract_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
