{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/state/schema/machine.schema.json",
  "title": "Human-authored Determa machine, format 1",
  "description": "Human source uses named native providers and custom languages. Exact executable identities are generated during explicit resolution.",
  "$ref": "https://determa.dev/state/schema/machine-grammar-v1.schema.json",
  "$defs": {
    "guardSlot": {
      "oneOf": [
        {
          "$ref": "https://determa.dev/state/schema/machine-grammar-v1.schema.json#/$defs/expression"
        },
        {
          "type": "object",
          "required": [
            "provider"
          ],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "$ref": "https://determa.dev/state/schema/machine.schema.json#/$defs/providerName"
            }
          }
        },
        {
          "$ref": "https://determa.dev/state/schema/machine.schema.json#/$defs/sourceLanguageSlot"
        }
      ],
      "$dynamicAnchor": "guardSlot"
    },
    "providerActionSlot": {
      "type": "object",
      "required": [
        "provider_actions"
      ],
      "additionalProperties": false,
      "properties": {
        "provider_actions": {
          "$ref": "https://determa.dev/state/schema/machine.schema.json#/$defs/providerName"
        }
      },
      "$dynamicAnchor": "providerActionSlot"
    },
    "actionList": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "https://determa.dev/state/schema/machine-grammar-v1.schema.json#/$defs/action"
          },
          {
            "$ref": "https://determa.dev/state/schema/machine.schema.json#/$defs/providerActionSlot"
          },
          {
            "$ref": "https://determa.dev/state/schema/machine.schema.json#/$defs/sourceLanguageSlot"
          }
        ]
      },
      "$dynamicAnchor": "actionList"
    },
    "providerName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$",
      "not": {
        "enum": [
          "cel",
          "determa"
        ]
      },
      "$dynamicAnchor": "providerName"
    },
    "sourceLanguageSlot": {
      "type": "object",
      "required": [
        "lang",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "lang": {
          "$ref": "https://determa.dev/state/schema/machine.schema.json#/$defs/providerName"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "$dynamicAnchor": "sourceLanguageSlot"
    },
    "providerCapabilities": {
      "not": {},
      "$dynamicAnchor": "providerCapabilities"
    },
    "providerBinding": {
      "not": {},
      "$dynamicAnchor": "providerBinding"
    }
  }
}
