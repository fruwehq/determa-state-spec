  "capability_meanings": [
    {
      "name": "structural_inspection",
      "source": "SPEC.md#12.1",
      "rule": "exact candidate shape, nonmutating"
    },
    {
      "name": "semantic_inspection",
      "source": "SPEC.md#12.2",
      "rule": "proved bounded nonmutating guard entrypoint"
    },
    {
      "name": "durable_embedded_processing",
      "source": "SPEC.md#17.11",
      "rule": "atomic checkpoint admission and processing"
    },
    {
      "name": "authoritative_scope_fencing",
      "source": "SPEC.md#18.1",
      "rule": "configured authority guard and old-writer refusal"
    },
    {
      "name": "worker_fencing",
      "source": "SPEC.md#18.4",
      "rule": "authenticated current epoch, attempt fence and principal"
    },
    {
      "name": "safe_relocation",
      "source": "SPEC.md#18.5",
      "rule": "proved source retirement and single-use destination-bound grant"
    },
    {
      "name": "native_effect_results",
      "source": "SPEC.md#19",
      "rule": "committed pinned effect route and authenticated result"
    },
    {
      "name": "lossless_projection",
      "source": "SPEC.md#20",
      "rule": "complete artifact round-trip for selected rows"
    },
    {
      "name": "saved_response_replay",
      "source": "SPEC.md#25.2",
      "rule": "exact first response at saved binding"
    },
    {
      "name": "deterministic_reexecution",
      "source": "SPEC.md#25.3",
      "rule": "exact equality only for deterministic portable closures"
    }
  ],
  "helper_participant_rules": [
    {
      "kind": "timer",
      "required_when": "timer profile advertises durable accepted work",
      "source": "SPEC.md#23",
      "rule": "separately identified helper artifact and receipt; absent required state blocks activation"
    },
    {
      "kind": "application",
      "required_when": "declared application projection archive participant",
      "source": "SPEC.md#22",
      "rule": "selected rows remain separately identified and losslessly reconstructible"
    },
    {
      "kind": "effect",
      "required_when": "native effect host profile",
      "source": "SPEC.md#19",
      "rule": "journal and checkpoint pair atomically consistent; unresolved work retained"
    },
    {
      "kind": "archive",
      "required_when": "archive import or recovery profile",
      "source": "SPEC.md#22",
      "rule": "all declared required participants verified before activation"
    }
