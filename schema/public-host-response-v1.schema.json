                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "scope_operation"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "code": {
                      "enum": [
                        "unsupported_host_protocol",
                        "unsupported_host_protocol_version",
                        "invalid_host_request",
                        "host_capability_mismatch",
                        "unauthorized_scope",
                        "operation_id_conflict",
                        "binding_unavailable",
                        "outcome_unknown",
                        "replay_evidence_expired",
                        "scope_not_active",
                        "stale_scope_authority",
                        "scope_operation_conflict",
                        "scope_generation_conflict",
                        "scope_transaction_in_doubt",
                        "scope_fence_unproven",
                        "scope_archive_incomplete",
                        "scope_archive_digest_mismatch",
                        "scope_destination_not_empty",
                        "scope_transfer_consumed",
                        "scope_transfer_target_mismatch",
                        "scope_restore_requires_quarantine",
                        "standalone_takeover_requires_fresh_scope",
                        "standalone_takeover_ambiguous_work",
                        "clone_has_unresolved_work",
                        "clone_isolation_unproven"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/state/schema/public-host-response-v1.schema.json",
  "title": "Determa State execution host response version 1",
  "$defs": {
    "capabilitiesValue": {
      "type": "object",
      "required": [
        "operation",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "capabilities"
        },
        "result": {
          "type": "object",
          "required": [
            "supported_operations",
            "profile_digest",
            "extension_reports",
            "authority_profile",
            "guarantees"
          ],
          "additionalProperties": false,
          "properties": {
            "supported_operations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "capabilities",
                  "create",
                  "admit",
                  "process",
                  "read",
                  "inspect",
                  "receipt",
                  "effect_result",
                  "cancel_effect",
                  "timer_command",
                  "scope_operation"
                ]
              }
            },
            "profile_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "extension_reports": {
              "type": "array",
              "items": {
                "$ref": "extension-capability-report-v1.schema.json"
              }
            },
            "authority_profile": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "host-authority-profile-report-v1.schema.json"
                }
              ]
            },
            "guarantees": {
              "type": "object",
              "required": [
                "inspection_structural",
                "inspection_semantic",
                "retained_history",
                "saved_response_replay",
                "deterministic_reexecution"
              ],
              "additionalProperties": false,
              "properties": {
                "inspection_structural": {
                  "type": "boolean"
                },
                "inspection_semantic": {
                  "type": "boolean"
                },
                "retained_history": {
                  "type": "boolean"
                },
                "saved_response_replay": {
                  "type": "boolean"
                },
                "deterministic_reexecution": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "createValue": {
      "type": "object",
      "required": [
        "operation",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create"
        },
        "result": {
          "type": "object",
          "required": [
            "checkpoint",
            "creation_receipt",
            "status",
            "emissions",
            "lifecycle_dispositions",
            "fault"
          ],
          "additionalProperties": false,
          "properties": {
            "checkpoint": {
              "$ref": "execution-checkpoint-v1.schema.json"
            },
            "creation_receipt": {
              "$ref": "execution-checkpoint-v1.schema.json#/$defs/creationReceipt"
            },
            "status": {
              "enum": [
                "running",
                "completed",
                "faulted"
              ]
            },
            "emissions": {
              "type": "array",
              "items": {
                "$ref": "core-step-result-v1.schema.json#/$defs/emission"
              }
            },
            "lifecycle_dispositions": {
              "type": "array",
              "items": {
                "$ref": "core-step-result-v1.schema.json#/$defs/lifecycleDisposition"
              }
            },
            "fault": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "aggregate-state-v1.schema.json#/$defs/fault"
                }
              ]
            }
          }
        }
      }
    },
    "admitValue": {
      "type": "object",
      "required": [
        "operation",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "admit"
        },
        "result": {
          "type": "object",
          "required": [
            "checkpoint",
            "acceptance_receipts",
            "status",
            "accepted"
          ],
          "additionalProperties": false,
          "properties": {
            "checkpoint": {
              "$ref": "execution-checkpoint-v1.schema.json"
            },
            "acceptance_receipts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "execution-checkpoint-v1.schema.json#/$defs/acceptanceReceipt"
              }
            },
            "status": {
              "enum": [
                "running",
                "completed",
                "faulted"
              ]
            },
            "accepted": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "aggregate-state-v1.schema.json#/$defs/envelope"
              }
            }
          }
        }
      }
    },
    "processValue": {
      "type": "object",
      "required": [
        "operation",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "process"
        },
        "result": {
          "type": "object",
          "required": [
            "checkpoint",
            "core_result",
            "terminal_receipt"
          ],
          "additionalProperties": false,
          "properties": {
            "checkpoint": {
              "$ref": "execution-checkpoint-v1.schema.json"
            },
            "core_result": {
              "$ref": "core-step-result-v1.schema.json"
            },
            "terminal_receipt": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "execution-checkpoint-v1.schema.json#/$defs/terminalEventReceipt"
                }
              ]
            }
          }
        }
      }
    },
    "readValue": {
      "type": "object",
      "required": [
        "operation",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "read"
        },
        "result": {
          "type": "object",
          "required": [
            "checkpoint",
            "observed_checkpoint_digest"
          ],
          "additionalProperties": false,
          "properties": {
            "checkpoint": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "execution-checkpoint-v1.schema.json"
                }
              ]
            },
            "observed_checkpoint_digest": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              ]
            }
          }
        }
      }
    },
    "inspectValue": {
      "type": "object",
      "required": [
        "operation",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "inspect"
        },
        "result": {
          "type": "object",
          "required": [
            "outcome",
            "observed_checkpoint_digest"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "$ref": "inspection-v1.schema.json#/$defs/outcome"
            },
            "observed_checkpoint_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "receiptValue": {
      "type": "object",
      "required": [
        "operation",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "receipt"
        },
        "result": {
          "type": "object",
          "required": [
            "saved_response",
            "retention"
          ],
          "additionalProperties": false,
          "properties": {
            "saved_response": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "public-host-response-v1.schema.json"
                }
              ]
            },
            "retention": {
              "enum": [
                "retained",
                "expired",
                "never_recorded",
                "unknown"
              ]
            }
          }
        }
      }
    },
    "effect_resultValue": {
      "type": "object",
      "required": [
        "operation",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "effect_result"
        },
        "result": {
          "type": "object",
          "required": [
            "result"
          ],
          "additionalProperties": false,
          "properties": {
            "result": {
              "$ref": "effect-result-response-v1.schema.json"
            }
          }
        }
      }
    },
    "cancel_effectValue": {
      "type": "object",
      "required": [
        "operation",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "cancel_effect"
        },
        "result": {
          "type": "object",
          "required": [
            "checkpoint",
            "journal"
          ],
          "additionalProperties": false,
          "properties": {
            "checkpoint": {
              "$ref": "execution-checkpoint-v1.schema.json"
            },
            "journal": {
              "$ref": "host-effect-journal-v1.schema.json"
            }
          }
        }
      }
    },
    "timer_commandValue": {
      "type": "object",
      "required": [
        "operation",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "timer_command"
        },
        "result": {
          "type": "object",
          "required": [
            "helper_receipt_digest",
            "helper_revision"
          ],
          "additionalProperties": false,
          "properties": {
            "helper_receipt_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "helper_revision": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        }
      }
    },
    "scope_operationValue": {
      "type": "object",
      "required": [
        "operation",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "scope_operation"
        },
        "result": {
          "type": "object",
          "required": [
            "action",
            "authority_result"
          ],
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "authority"
            },
            "authority_result": {
              "$ref": "host-authority-operation-v1.schema.json#/$defs/result"
            }
          }
        }
      }
    }
  }
}
