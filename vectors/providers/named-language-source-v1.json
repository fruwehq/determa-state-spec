        },
        "source_media_type": "text/plain",
        "source": "approved_for_review(event, variables)"
      },
      {
        "kind": "actions",
        "locator": "/machines/0/root/states/pending/on_events/submit/2/action/0",
        "provider_reference": {
          "identifier": "example.python-compiler",
          "version": "1.0.0",
