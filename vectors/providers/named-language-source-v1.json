{
  "artifact_format": "determa.language_source",
  "artifact_schema_version": 1,
  "content": {
    "template": {
      "format": 1,
      "namespace": "example.review",
      "events": {
        "submit": {
          "direction": "input",
          "payload": {
            "approved": {
              "type": "bool",
              "required": true
            },
            "review_mode": {
              "type": "string",
              "required": true
            }
          }
        }
      },
      "machines": [
        {
          "machine_id": "order",
          "root": {
            "type": "composite",
            "variables": {
              "accepted": {
                "type": "bool",
                "init": false
              }
            },
            "initial": {
              "transition_to": "pending"
            },
            "states": {
              "pending": {
                "on_events": {
                  "submit": [
                    {
                      "guard": "event.payload.approved && event.payload.review_mode == \"automatic\"",
                      "transition_to": "complete"
                    },
                    {
                      "guard": {
                        "provider": "review"
                      },
                      "action": [
                        {
                          "provider_actions": "record-review"
                        }
                      ],
                      "transition_to": "complete"
                    },
                    {
                      "guard": {
                        "lang": "eligibility",
                        "source": "approved_for_review(event, variables)"
                      },
                      "action": [
                        {
                          "lang": "python",
                          "source": "sdk.record_review(event)\nreturn {\"actions\": []}\n"
                        }
                      ],
                      "transition_to": "complete"
                    }
                  ]
                }
              },
              "complete": {
                "type": "final"
              }
            }
          }
        }
      ]
    },
    "regions": [
      {
        "kind": "guard",
        "locator": "/machines/0/root/states/pending/on_events/submit/2/guard",
        "provider_reference": {
          "identifier": "example.guard-compiler",
