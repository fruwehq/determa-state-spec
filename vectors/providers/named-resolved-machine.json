{
  "format": 1,
  "namespace": "example.review",
  "events": {
    "submit": {
      "direction": "input",
      "payload": {
        "approved": {
          "type": "bool",
          "required": true
        },
        "review_mode": {
          "type": "string",
          "required": true
        }
      }
    }
  },
  "machines": [
    {
      "machine_id": "order",
      "root": {
        "type": "composite",
        "variables": {
          "accepted": {
            "type": "bool",
            "init": false
          }
        },
        "initial": {
          "transition_to": "pending"
        },
        "states": {
          "pending": {
            "on_events": {
              "submit": [
                {
                  "guard": "event.payload.approved && event.payload.review_mode == \"automatic\"",
                  "transition_to": "complete"
                },
                {
                  "guard": {
                    "provider": {
                      "provider_reference": {
                        "identifier": "example.native-review",
                        "version": "1.0.0",
                        "content_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                      },
                      "source_media_type": "application/octet-stream",
                      "source_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                      "dependencies": [],
                      "capabilities": {
                        "deterministic": false,
                        "pure": false,
                        "portable": false,
                        "semantically_introspectable": false,
                        "process_contained": false,
                        "external_io_capable": true
                      },
                      "input_types": {
                        "event": "event_envelope",
                        "variables": "typed_variables"
                      },
                      "output_type": "bool"
                    }
                  },
                  "action": [
                    {
                      "provider_actions": {
                        "provider_reference": {
                          "identifier": "example.native-actions",
                          "version": "1.0.0",
                          "content_digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
                        },
                        "source_media_type": "application/octet-stream",
                        "source_digest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
                        "dependencies": [],
                        "capabilities": {
                          "deterministic": false,
                          "pure": false,
                          "portable": false,
                          "semantically_introspectable": false,
                          "process_contained": false,
                          "external_io_capable": true
                        },
                        "input_types": {
                          "event": "event_envelope",
                          "variables": "typed_variables"
                        },
                        "output_type": "structured_actions"
                      }
                    }
                  ],
                  "transition_to": "complete"
                },
                {
                  "guard": "event.payload.approved && event.payload.review_mode == \"sdk\"",
                  "action": [
                    {
                      "provider_actions": {
                        "provider_reference": {
                          "identifier": "example.python-runtime",
                          "version": "1.0.0",
                          "content_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
                        },
                        "source_media_type": "text/x-python",
                        "source_digest": "sha256:d78d1c509917207fb44dbbb5f7f2553b61727e7e1d994984b5d41d5760190308",
                        "source": "sdk.record_review(event)\nreturn {\"actions\": []}\n",
                        "dependencies": [
                          {
                            "identifier": "example.review-sdk",
                            "version": "1.0.0",
                            "content_digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
                          }
                        ],
                        "capabilities": {
                          "deterministic": false,
                          "pure": false,
                          "portable": false,
                          "semantically_introspectable": false,
                          "process_contained": false,
                          "external_io_capable": true
                        },
                        "input_types": {
                          "event": "event_envelope",
                          "variables": "typed_variables"
                        },
                        "output_type": "structured_actions"
                      }
                    }
                  ],
                  "transition_to": "complete"
                }
              ]
            }
          },
          "complete": {
            "type": "final"
          }
        }
      }
    }
  ]
}
